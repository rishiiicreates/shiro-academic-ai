{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://shiro-20-production.up.railway.app/api/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "https://shiro-20-production.up.railway.app/images/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
