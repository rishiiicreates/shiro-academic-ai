# ==========================================
# Shiro RAG Environment Variables
# ==========================================

# --- Frontend (Vite) ---
# Set this to your deployed Spring Boot backend URL or leave empty for local /api proxy
VITE_API_URL=

# --- Backend (Spring Boot) ---
# Your Google Gemini API Key (Required for AI chat & reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Retrieval Sidecar URL
SIDECAR_URL=http://127.0.0.1:8001

# Storage directory for threads and images
DATA_DIR=./data

# --- Sidecar (FastAPI + FastEmbed ONNX) ---
EMBEDDINGS_DIR=/path/to/chiroshiro-vector-embeddings
