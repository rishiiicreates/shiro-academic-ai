{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://shiro-academic-ai.onrender.com/api/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "https://shiro-academic-ai.onrender.com/images/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
